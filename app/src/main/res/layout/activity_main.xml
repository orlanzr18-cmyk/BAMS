<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgLogoBams"
        android:layout_width="180dp"
        android:layout_height="88dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="Logo de BAMS"
        android:scaleType="fitStart"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/logo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarSesion"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#E6EEF8"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="16dp"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textColor="#082F5B"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="21dp"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="16dp"
        app:iconTint="#082F5B"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtituloBams"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/imgLogoBams"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25"
        app:rippleColor="#CFE0F5" />

    <TextView
        android:id="@+id/tvSubtituloBams"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="Panel principal · Venta de baterías"
        android:textColor="#526D8A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogoBams" />

    <ScrollView
        android:id="@+id/scrollBotones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloBams">

        <LinearLayout
            android:id="@+id/contenedorBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVentas"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#00A8E8"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="24dp"
                android:text="Ventas\nRegistrar nueva venta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="end"
                app:iconSize="30dp"
                app:iconTint="#FFFFFF"
                app:rippleColor="#66D4FF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerVentas"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#082F5B"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="Ver ventas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconGravity="end"
                app:iconSize="28dp"
                app:iconTint="#7CC6FE"
                app:rippleColor="#164A84" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProducto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FFFFFF"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="Ver Inventario"
                android:textAllCaps="false"
                android:textColor="#082F5B"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_sort_by_size"
                app:iconGravity="end"
                app:iconSize="28dp"
                app:iconTint="#00A8E8"
                app:rippleColor="#E6F6FD"
                app:strokeColor="#DCE6F2"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarProducto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FFFFFF"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="Agregar producto"
                android:textAllCaps="false"
                android:textColor="#082F5B"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_add"
                app:iconGravity="end"
                app:iconSize="28dp"
                app:iconTint="#00A8E8"
                app:rippleColor="#E6F6FD"
                app:strokeColor="#DCE6F2"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModificarProducto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:backgroundTint="#FFFFFF"
                android:gravity="start|center_vertical"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="24dp"
                android:text="Modificar producto"
                android:textAllCaps="false"
                android:textColor="#082F5B"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconGravity="end"
                app:iconSize="28dp"
                app:iconTint="#00A8E8"
                app:rippleColor="#E6F6FD"
                app:strokeColor="#DCE6F2"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>